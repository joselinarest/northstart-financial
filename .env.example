# NORTHSTAR ENVIRONMENT GUIDE — copy to .env.local; never commit real values.
APP_URL=http://localhost:3100
# Production Amplify only: name or ARN of the AWS Secrets Manager JSON secret containing server-only values.
NORTHSTAR_SECRET_ID=
# Local sign-in is accepted only on localhost when this is explicitly true.
ALLOW_LOCAL_DEV_AUTH=false
# AWS Cognito user-pool authentication. Use a public app client without a client secret.
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_ISSUER=
# Optional server alias; when set, keep equal to NEXT_PUBLIC_COGNITO_CLIENT_ID.
COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
# 32-byte base64 key for AES-GCM encryption of financial-provider tokens.
TOKEN_ENCRYPTION_KEY=

# Required AWS PostgreSQL (RDS/Aurora) connection. Northstar uses PostgreSQL as its only database.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=require
# Set false only when the AWS database uses a certificate chain unavailable to Node and the connection is protected by a trusted private network.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# OpenAI Responses API: powers the read-only Investment Coach. Create a server-side API key; never expose it as NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Google OAuth credentials belong in Cognito identity-provider settings, not this app.

# Plaid read-only data: banks, cards, transactions, recurring bills, investments, liabilities.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Use production only after Plaid approves the application and a Production secret is installed.
# Existing Sandbox/Development access tokens cannot be used after changing environments.
# Products requested in Plaid Link. Recurring transaction insights are provided through the Transactions product.
PLAID_PRODUCTS=transactions,investments,liabilities
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
# Production OAuth callback. Must be HTTPS and allowlisted under Plaid Dashboard → Developers → API.
PLAID_REDIRECT_URI=

# Licensed market/news data only. Do not request or configure trading scopes.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex
ALPACA_CLOCK_BASE_URL=https://paper-api.alpaca.markets
# Options chain feed: indicative is delayed/modified; OPRA requires eligible real-time data access.
ALPACA_OPTIONS_FEED=indicative
FINNHUB_API_KEY=
FRED_API_KEY=
# NewsAPI.ai / Event Registry. NEWS_API_KEY is also accepted for existing deployments.
NEWSAPI_AI_KEY=
YOUTUBE_API_KEY=

# Verification, email, mobile push, monitoring and background synchronization.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
RESEND_API_KEY=
# Comma-separated platform administrators. Only these bootstrap accounts can invite an owner to create a separate household.
# Every other authenticated email must accept a valid invitation before it can access any workspace data.
FAMILY_APPROVER_EMAILS=lisdanay.dm@gmail.com,jose.linarest@gmail.com

# Optional production real-time channel (for example AWS API Gateway WebSocket).
# The client authenticates immediately after connecting. Without this value,
# Northstar uses a safe 30-second refresh fallback.
NEXT_PUBLIC_REALTIME_WS_URL=
EMAIL_FROM=Northstar <security@example.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
SENTRY_DSN=
